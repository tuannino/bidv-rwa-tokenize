// Lược đồ Postgres cho PoC BIDV RWA (điện gió).
//
// Phase 1 dùng Txn + AuditLog (lưu giao dịch mint + dấu vết kiểm quyền).
// Investor / Role / Permission khai báo SỚM theo steering để Phase 4 (KYC/RBAC/audit thật)
// chỉ việc chuyển bảng RBAC in-code sang DB, KHÔNG phải đổi chữ ký `can(role, action)`.
//
// Áp lược đồ:  npm run db:push      (cần DATABASE_URL trỏ tới Postgres đang chạy)
//
// ⚠️ MỌI cột thời gian PHẢI có `@db.Timestamptz(3)`.
// Mặc định của Prisma là `timestamp(3)` KHÔNG mang timezone. Khi đó driver `pg` đọc giá trị
// ra và hiểu nó là giờ ĐỊA PHƯƠNG của tiến trình Node, trong khi Postgres (container) ghi
// bằng UTC -> mốc thời gian bị lệch đúng bằng offset (vd +07 thì lệch 7 giờ), và trang
// /mint, /audit hiển thị sai giờ. `timestamptz` lưu kèm offset nên đọc ra luôn đúng mốc,
// bất kể tiến trình Node và Postgres ở timezone nào.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TxStatus {
  PENDING
  CONFIRMED
  FAILED
}

enum AuditOutcome {
  ALLOWED
  DENIED
  SUCCESS
  FAILURE
}

/// Trạng thái lệnh mua WPT. Nguồn sự thật của bảng này là
/// app/src/lib/bank/purchase.state.ts (ORDER_STATUSES + ORDER_TRANSITIONS).
///
/// ⚠️ KHÔNG thêm trạng thái mô tả "đã trả tiền nhưng chưa nhận token": chuyển VNDB và
/// chuyển WPT nằm trong CÙNG một giao dịch nên tình huống đó không tồn tại. Test
/// app/test/purchase-state.test.ts chốt điều này bằng máy.
enum OrderStatus {
  PLACED
  CHECKING
  EXECUTING
  COMPLETED
  REJECTED
  FAILED
  EXPIRED
}

/// Giao dịch đã gửi lên ledger (mọi chain, kể cả mock).
model Txn {
  id           String   @id @default(uuid())
  /// ChainKey: hardhat-local | evm | stellar | mock
  chain        String
  /// Tên nghiệp vụ: mint | whitelist | burn | transfer | freeze | forcedTransfer
  operation    String
  txHash       String
  status       TxStatus
  fromWallet   String?
  toWallet     String?
  /// Decimal thay vì BigInt: uint256 vượt tầm int8 của Postgres.
  amount       Decimal? @db.Decimal(78, 0)
  reason       String?
  /// Vai trò đã thực hiện — phục vụ đối soát trách nhiệm.
  actorRole    String
  actorAddress String?
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  @@index([chain, createdAt])
  @@index([toWallet])
  @@index([txHash])
}

/// Dấu vết mọi lần kiểm quyền và mọi thao tác đặc quyền (kênh `(audit)` chỉ đọc bảng này).
model AuditLog {
  id        String       @id @default(uuid())
  actorRole String
  /// Action của RBAC, vd token:mint
  action    String
  target    String?
  outcome   AuditOutcome
  detail    String?
  chain     String?
  createdAt DateTime     @default(now()) @db.Timestamptz(3)

  @@index([createdAt])
  @@index([actorRole, action])
}

/// Lệnh mua WPT của nhà đầu tư (BE-02; bảng thuộc phạm vi BE-09, khai trước ở đây).
///
/// `vndAmount` được CHỐT lúc đặt lệnh và không tính lại khi khớp: nhà đầu tư trả đúng
/// giá đã thấy. Vì vậy nó là một CỘT, không phải giá trị suy ra từ `wptAmount`.
///
/// KHÔNG có cột số dư WPT: số dư luôn đọc từ chuỗi. Ghi vào đây là tạo nguồn sự thật
/// thứ hai, và nó sẽ lệch ngay lần đầu có giao dịch không đi qua hệ thống này.
model PurchaseOrder {
  id             String      @id @default(uuid())
  /// ChainKey: hardhat-local | evm | stellar | mock
  chain          String
  investorWallet String
  /// Decimal thay vì BigInt: uint256 vượt tầm int8 của Postgres.
  wptAmount      Decimal     @db.Decimal(78, 0)
  vndAmount      Decimal     @db.Decimal(78, 0)
  status         OrderStatus @default(PLACED)
  /// Có ngay khi gửi giao dịch, TRƯỚC khi chờ biên nhận — để tiến trình chết giữa
  /// chừng vẫn còn dấu vết đối soát.
  txHash         String?
  reason         String?
  /// Vai đã đặt lệnh — phục vụ đối soát trách nhiệm.
  actorRole      String
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @db.Timestamptz(3)

  /// Nhà đầu tư xem lệnh của mình: lọc theo ví, sắp theo thời gian.
  @@index([investorWallet, createdAt])
  /// Ngân hàng lọc theo trạng thái; cũng là chỉ mục cho `expireOrders`.
  @@index([status, createdAt])
  @@index([txHash])
}

/// Nhà đầu tư + trạng thái KYC (Phase 4 nối provider thật).
model Investor {
  id           String    @id @default(uuid())
  wallet       String    @unique
  fullName     String?
  kycStatus    String    @default("PENDING")
  kycReference String?
  kycProvider  String?
  kycDecidedAt DateTime? @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)
}

/// RBAC trong DB (Phase 4). Hiện tại bảng role->permission nằm ở
/// app/src/lib/rbac/permissions.ts; chuyển sang đây KHÔNG đổi chữ ký can().
model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  permissions RolePermission[]
}

model Permission {
  id     String           @id @default(uuid())
  /// vd token:mint
  action String           @unique
  roles  RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}
