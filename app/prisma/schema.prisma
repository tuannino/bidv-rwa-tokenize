// Lược đồ Postgres cho PoC BIDV RWA (điện gió).
//
// Phase 1 dùng Txn + AuditLog (lưu giao dịch mint + dấu vết kiểm quyền).
// Investor / Role / Permission khai báo SỚM theo steering để Phase 4 (KYC/RBAC/audit thật)
// chỉ việc chuyển bảng RBAC in-code sang DB, KHÔNG phải đổi chữ ký `can(role, action)`.
//
// Áp lược đồ:  npm run db:push      (cần DATABASE_URL trỏ tới Postgres đang chạy)
//
// ⚠️ MỌI cột thời gian PHẢI có `@db.Timestamptz(3)`.
// Mặc định của Prisma là `timestamp(3)` KHÔNG mang timezone. Khi đó driver `pg` đọc giá trị
// ra và hiểu nó là giờ ĐỊA PHƯƠNG của tiến trình Node, trong khi Postgres (container) ghi
// bằng UTC -> mốc thời gian bị lệch đúng bằng offset (vd +07 thì lệch 7 giờ), và trang
// /mint, /audit hiển thị sai giờ. `timestamptz` lưu kèm offset nên đọc ra luôn đúng mốc,
// bất kể tiến trình Node và Postgres ở timezone nào.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TxStatus {
  PENDING
  CONFIRMED
  FAILED
}

enum AuditOutcome {
  ALLOWED
  DENIED
  SUCCESS
  FAILURE
}

/// Giao dịch đã gửi lên ledger (mọi chain, kể cả mock).
model Txn {
  id           String   @id @default(uuid())
  /// ChainKey: hardhat-local | evm | stellar | mock
  chain        String
  /// Tên nghiệp vụ: mint | whitelist | burn | transfer | freeze | forcedTransfer
  operation    String
  txHash       String
  status       TxStatus
  fromWallet   String?
  toWallet     String?
  /// Decimal thay vì BigInt: uint256 vượt tầm int8 của Postgres.
  amount       Decimal? @db.Decimal(78, 0)
  reason       String?
  /// Vai trò đã thực hiện — phục vụ đối soát trách nhiệm.
  actorRole    String
  actorAddress String?
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  @@index([chain, createdAt])
  @@index([toWallet])
  @@index([txHash])
}

/// Dấu vết mọi lần kiểm quyền và mọi thao tác đặc quyền (kênh `(audit)` chỉ đọc bảng này).
model AuditLog {
  id        String       @id @default(uuid())
  actorRole String
  /// Action của RBAC, vd token:mint
  action    String
  target    String?
  outcome   AuditOutcome
  detail    String?
  chain     String?
  createdAt DateTime     @default(now()) @db.Timestamptz(3)

  @@index([createdAt])
  @@index([actorRole, action])
}

// =============================================================================
//  BE-09 — LỆNH MUA WPT
// =============================================================================

/// Lệnh mua WPT của nhà đầu tư.
///
/// ⚠️ TRẠNG THÁI lưu dạng `String`, KHÔNG dùng enum của Prisma (design BE-09 QĐ-4).
/// Danh sách giá trị hợp lệ là `ORDER_STATUSES` ở `app/src/lib/store/order.store.port.ts`,
/// lấy đúng theo mô hình đã chốt ở BE-02:
///     PLACED → CHECKING → EXECUTING → COMPLETED
///                │            └────→ FAILED
///                └────→ REJECTED
///     PLACED → EXPIRED
/// Cổng lưu trữ CHẶN giá trị ngoài danh sách ở CẢ hai bản (bộ nhớ + Postgres), vì cột
/// `String` thì cơ sở dữ liệu không tự chặn được — xem `assertOrderStatus`.
///
/// ⚠️ KHÔNG thêm trạng thái mô tả "đã trả tiền nhưng chưa nhận token": chuyển VNDB và
/// chuyển WPT nằm trong CÙNG một giao dịch on-chain nên tình huống đó không tồn tại, và
/// mã viết ra để xử lý nó là mã xử lý tình huống tưởng tượng.
///
/// `vndAmount` được CHỐT lúc đặt lệnh, KHÔNG tính lại khi khớp: nhà đầu tư trả đúng giá
/// đã thấy lúc bấm. Vì vậy nó là một CỘT, không phải giá trị suy ra từ `wptAmount`.
///
/// KHÔNG có cột số dư WPT: số dư luôn đọc từ chuỗi. Ghi vào đây là tạo nguồn sự thật thứ
/// hai, và nó lệch ngay lần đầu có giao dịch không đi qua hệ thống này.
///
/// BE-14: bảng chứa CẢ lệnh mua lẫn lệnh bán, phân biệt bằng cột `side`, dùng chung bảy trạng
/// thái. Giữ tên `PurchaseOrder` để không đổi tên bảng trên cơ sở dữ liệu đang chạy; tách hai
/// bảng thì mọi truy vấn và đối soát phải làm hai lần.
model PurchaseOrder {
  id             String   @id @default(uuid())
  /// ChainKey: hardhat-local | evm | stellar | mock
  chain          String
  investorWallet String
  /// Chiều lệnh (BE-14). Giá trị hợp lệ: ORDER_SIDES ở lib/store/order.store.port.ts.
  /// Mặc định `BUY`: mọi lệnh có trước BE-14 là lệnh mua, nên dòng cũ tự mang đúng chiều.
  side           String   @default("BUY")
  /// Decimal thay vì BigInt: uint256 vượt tầm int8 của Postgres.
  wptAmount      Decimal  @db.Decimal(78, 0)
  /// Số VNDB, chốt tại thời điểm đặt lệnh: lệnh mua là số phải trả, lệnh bán là số nhận về.
  vndAmount      Decimal  @db.Decimal(78, 0)
  status         String   @default("PLACED")
  /// R1.4 — DUY NHẤT là ràng buộc chống một giao dịch bị gắn cho hai lệnh khác nhau.
  /// Postgres coi mỗi NULL là khác nhau, nên lệnh chưa gửi giao dịch không đụng ràng buộc.
  txHash         String?  @unique
  /// Lý do từ chối / thất bại / hết hạn, hiển thị được cho người dùng.
  reason         String?
  /// Vai đã đặt lệnh — phục vụ đối soát trách nhiệm.
  actorRole      String
  /// Mốc NĂM BƯỚC QUYẾT TOÁN (BE-14). Bước 1 "tạo lệnh" dùng `createdAt`; bốn cột dưới là
  /// bốn bước còn lại, ghi CÙNG câu lệnh chuyển trạng thái nên không lệch với `status`.
  /// `null` = chưa tới bước đó. Ánh xạ trạng thái -> bước nằm ở lib/bank/settlement-steps.ts.
  checkingAt     DateTime? @db.Timestamptz(3)
  reconciledAt   DateTime? @db.Timestamptz(3)
  settlingAt     DateTime? @db.Timestamptz(3)
  completedAt    DateTime? @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  /// R1.3 — nhà đầu tư xem lệnh của mình: lọc theo ví, sắp theo thời gian.
  @@index([investorWallet, createdAt])
  /// R1.3 — ngân hàng lọc theo trạng thái; cũng là chỉ mục cho việc dọn lệnh quá hạn.
  @@index([status, createdAt])
  /// BE-14 — số liệu khớp lệnh trong ngày theo từng chiều: lọc chiều + trạng thái + mốc hoàn tất.
  @@index([side, status, completedAt])
}

// =============================================================================
//  BE-09 — CHIA LỢI NHUẬN
// =============================================================================

/// Một kỳ chia lợi nhuận đã chốt quyền.
///
/// `periodKey` DUY NHẤT (R2.2) là chốt chặn "mở cùng một kỳ hai lần". Không dựa vào
/// kiểm tra trong mã trước khi ghi: hai tiến trình chạy song song có thể cùng vượt qua
/// kiểm tra rồi cùng ghi, chỉ ràng buộc ở cơ sở dữ liệu mới nguyên tử.
///
/// `snapshotId` là mã ảnh chụp số dư trên chuỗi, lấy từ event `Snapshot` trong biên nhận
/// (`ILedgerSnapshot.takeSnapshot`). KHÔNG tự tăng số đếm và KHÔNG gọi
/// `getCurrentSnapshotId()` sau khi gửi giao dịch: tx snapshot của người khác chen vào
/// giữa hai lời gọi là lấy về mã của họ, rồi chia lợi nhuận theo ảnh chụp sai.
///
/// `totalSupplyAt` lưu lại thay vì đọc lại từ chuỗi mỗi lần tính: đây là mẫu số của mọi
/// phép chia trong kỳ, giữ nó cạnh `snapshotId` để hồ sơ đã chốt không đổi theo chuỗi.
model DistributionPeriod {
  id            String               @id @default(uuid())
  /// Mã kỳ do nghiệp vụ đặt, ví dụ "2026-Q1". DUY NHẤT toàn hệ.
  periodKey     String               @unique
  /// Mã ảnh chụp trên chuỗi. Int vì mã snapshot là số đếm nhỏ, không phải uint256.
  snapshotId    Int
  /// Tổng VNDB của kỳ.
  totalAmount   Decimal              @db.Decimal(78, 0)
  /// Tổng cung WPT tại ảnh chụp — mẫu số khi tính phần từng ví.
  totalSupplyAt Decimal              @db.Decimal(78, 0)
  /// Giá trị hợp lệ: DISTRIBUTION_PERIOD_STATUSES ở lib/store/distribution.store.port.ts
  status        String               @default("OPEN")
  /// ChainKey: hardhat-local | evm | stellar | mock
  chain         String
  /// Thời điểm chốt quyền.
  openedAt      DateTime             @default(now()) @db.Timestamptz(3)
  completedAt   DateTime?            @db.Timestamptz(3)
  payouts       DistributionPayout[]

  @@index([status, openedAt])
  @@index([chain, openedAt])
}

/// Phần lợi nhuận của MỘT ví trong MỘT kỳ.
///
/// Duy nhất `(periodId, investorWallet)` (R2.4) là chốt chặn chia trùng cho một nhà đầu
/// tư trong cùng kỳ. Đây là ràng buộc quan trọng nhất của bảng này: chia trùng là mất
/// tiền thật, và không có cách nào phát hiện muộn ngoài đối soát tay.
///
/// `amount` lưu lại thay vì tính lại từ `balanceAt / totalSupplyAt`: số đã chuyển cho
/// người ta thì không được đổi theo bất cứ thứ gì sửa sau đó.
model DistributionPayout {
  id             String             @id @default(uuid())
  periodId       String
  period         DistributionPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  investorWallet String
  /// Số dư WPT của ví TẠI ảnh chụp của kỳ.
  balanceAt      Decimal            @db.Decimal(78, 0)
  /// Số VNDB được chia, chốt tại thời điểm lập hồ sơ.
  amount         Decimal            @db.Decimal(78, 0)
  /// Giá trị hợp lệ: DISTRIBUTION_PAYOUT_STATUSES ở lib/store/distribution.store.port.ts
  status         String             @default("PENDING")
  txHash         String?
  /// Số thứ tự lô đã gửi. Chia lô là việc của nghiệp vụ (BE-06); ở đây chỉ ghi lại để
  /// chạy lại đúng lô lỗi thay vì chạy lại cả kỳ.
  batchNo        Int?
  createdAt      DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @db.Timestamptz(3)

  /// R2.4 — một nhà đầu tư chỉ có MỘT hồ sơ trong một kỳ.
  @@unique([periodId, investorWallet])
  /// Task 2.3 — nhà đầu tư tra lịch sử lợi nhuận của chính mình.
  @@index([investorWallet, createdAt])
  /// Lấy các hồ sơ còn phải chi của một kỳ, và chạy lại lô lỗi.
  @@index([periodId, status])
}

// =============================================================================
//  BE-09 — TẤT TOÁN
// =============================================================================

/// Một đợt tất toán (đóng quỹ) đã khởi tạo.
///
/// `navRate` lưu ở đây là giá NAV ÁP CHO ĐỢT NÀY, không phải giá đang đặt trên chuỗi.
/// Chuỗi chỉ giữ một giá trị hiện hành (`ILedgerSettlement.navRate`); sửa nó không được
/// làm đổi hồ sơ của đợt đã chốt.
model SettlementRound {
  id          String            @id @default(uuid())
  /// Mã ảnh chụp số dư dùng để lập danh sách người nắm giữ của đợt.
  snapshotId  Int
  /// Số VNDB trả cho mỗi 1 WPT, chốt cho đợt này.
  navRate     Decimal           @db.Decimal(78, 0)
  /// Giá trị hợp lệ: SETTLEMENT_ROUND_STATUSES ở lib/store/settlement.store.port.ts
  status      String            @default("INITIATED")
  /// ChainKey: hardhat-local | evm | stellar | mock
  chain       String
  initiatedAt DateTime          @default(now()) @db.Timestamptz(3)
  completedAt DateTime?         @db.Timestamptz(3)
  cases       SettlementCase[]

  @@index([status, initiatedAt])
  @@index([chain, initiatedAt])
}

/// Hồ sơ tất toán của MỘT người nắm giữ trong MỘT đợt.
///
/// BỐN trạng thái theo R3.2, mỗi trạng thái một cột thời điểm (R3.3):
///     NOTIFIED  → notifiedAt   (thông báo, ngoài chuỗi — không có giao dịch)
///     CONFIRMED → confirmedAt  (nhà đầu tư đồng ý, `settlement:confirm` — không có giao dịch)
///     PAID      → paidAt   + paidTxHash
///     BURNED    → burnedAt + burnTxHash
///
/// ⚠️ ĐỪNG rút gọn còn hai trạng thái: màn hình FE-10 cần theo dõi đủ bốn, và gộp
/// "đã chi trả" với "đã đốt" là mất đúng cái mốc phân biệt tiền đã ra khỏi ngân hàng
/// với token đã bị thu hồi — hai việc không cùng một giao dịch.
///
/// Chỉ hai cột mã giao dịch, không phải bốn: R3.3 nói "mã giao dịch tương ứng NẾU CÓ",
/// và hai bước đầu không sinh giao dịch nào. Thêm hai cột luôn rỗng chỉ để cho cân đối
/// là mời người đọc sau đi tìm giao dịch không tồn tại.
///
/// `payoutAmount` chốt tại thời điểm lập hồ sơ, KHÔNG tính lại từ `navRate` (task 3.4):
/// nếu giá NAV bị sửa thì hồ sơ đã chốt không đổi theo.
model SettlementCase {
  id           String          @id @default(uuid())
  roundId      String
  round        SettlementRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  holderWallet String
  /// Số WPT phải thu hồi.
  wptAmount    Decimal         @db.Decimal(78, 0)
  /// Số VNDB phải trả, chốt tại thời điểm lập hồ sơ.
  payoutAmount Decimal         @db.Decimal(78, 0)
  /// Giá trị hợp lệ: SETTLEMENT_CASE_STATUSES ở lib/store/settlement.store.port.ts
  status       String          @default("NOTIFIED")
  notifiedAt   DateTime?       @db.Timestamptz(3)
  confirmedAt  DateTime?       @db.Timestamptz(3)
  paidAt       DateTime?       @db.Timestamptz(3)
  paidTxHash   String?
  burnedAt     DateTime?       @db.Timestamptz(3)
  burnTxHash   String?
  createdAt    DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime        @updatedAt @db.Timestamptz(3)

  /// R3.4 — chốt chặn chi trả hoặc đốt trùng cho một ví trong cùng đợt.
  @@unique([roundId, holderWallet])
  /// Nhà đầu tư xem hồ sơ tất toán của chính mình.
  @@index([holderWallet, createdAt])
  /// Lấy các hồ sơ còn phải xử lý của một đợt.
  @@index([roundId, status])
}

// =============================================================================
//  BE-09 — TIẾN TRÌNH HẸN GIỜ
// =============================================================================

/// Mốc chạy của tiến trình hẹn giờ (BE-07).
///
/// Duy nhất `(jobName, periodKey)` (R4.2) là chốt chặn chạy trùng, và nó phải nằm ở cơ
/// sở dữ liệu chứ không phải ở mã: hai instance web cùng nhận một lịch — chuyện thường
/// gặp khi chạy nhiều bản sao hoặc khi lịch trước chưa xong đã tới lịch sau — sẽ cùng
/// đọc thấy "chưa chạy" rồi cùng chạy. Ghi dòng mốc TRƯỚC khi làm việc, thất bại ở
/// ràng buộc này chính là cách một bản biết bản kia đã nhận việc.
///
/// `periodKey` là chuỗi tự do do từng công việc quy ước (kỳ chia "2026-Q1", ngày
/// "2026-09-18", đợt tất toán...), không phải khóa ngoài: một công việc có thể chạy theo
/// kỳ không tương ứng bảng nào.
model KeeperRun {
  id         String    @id @default(uuid())
  /// Tên công việc, ví dụ "expire-orders".
  jobName    String
  /// Kỳ mà lần chạy này phụ trách.
  periodKey  String
  startedAt  DateTime  @default(now()) @db.Timestamptz(3)
  finishedAt DateTime? @db.Timestamptz(3)
  /// Giá trị hợp lệ: KEEPER_RUN_STATUSES ở lib/store/keeper.store.port.ts
  status     String    @default("RUNNING")
  /// Thông báo lỗi khi thất bại.
  error      String?

  /// R4.2 — một công việc chạy đúng một lần cho một kỳ.
  @@unique([jobName, periodKey])
  @@index([jobName, startedAt])
  @@index([status, startedAt])
}

/// Nhà đầu tư + trạng thái KYC (Phase 4 nối provider thật).
model Investor {
  id           String    @id @default(uuid())
  wallet       String    @unique
  fullName     String?
  kycStatus    String    @default("PENDING")
  kycReference String?
  kycProvider  String?
  kycDecidedAt DateTime? @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)
}

/// RBAC trong DB (Phase 4). Hiện tại bảng role->permission nằm ở
/// app/src/lib/rbac/permissions.ts; chuyển sang đây KHÔNG đổi chữ ký can().
model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  /// BE-04 — vai này được đổi THAM SỐ HỆ THỐNG (giá phát hành, ngưỡng) hay không.
  ///
  /// Cột RIÊNG, không phải một dòng `Permission`, và đó là chủ đích: đây là lớp thứ HAI
  /// độc lập với bảng quyền, cùng mô hình với cờ `ENABLE_DEMO_PAYMENT_MINT` ở
  /// `lib/rbac/demo-payment.ts`. Khai nó thành một quyền thì nó nằm chung một bảng với
  /// `treasury:manage`, và một lần gán vai sai sẽ mở CẢ HAI lớp cùng lúc — tức là không
  /// còn hai lớp nữa.
  ///
  /// Mặc định `false` (nguyên tắc đóng): vai mới thêm vào không tự nhiên đổi được giá bán.
  ///
  /// ⚠️ Nguồn ĐANG CÓ HIỆU LỰC là bảng trong mã `lib/rbac/config-role.ts`, giống cách
  /// `ROLE_PERMISSIONS` đang là nguồn thật của `permissions` ở bảng này. Cột này là ĐÍCH
  /// để AU-02 chuyển sang, khai sớm để lược đồ không phải đổi lần nữa.
  isConfig    Boolean          @default(false)
  permissions RolePermission[]
}

// =============================================================================
//  BE-04 — THAM SỐ HỆ THỐNG VÀ DỰ ÁN
// =============================================================================

/// Tham số hệ thống cán bộ ngân hàng cấu hình được (giá phát hành, ngưỡng đổi giá).
///
/// `key` là khoá chính, KHÔNG phải `id` riêng kèm `@unique` trên `key`: tra cứu luôn
/// bằng khoá nghiệp vụ, và một `id` uuid thêm vào chỉ tạo khả năng có hai dòng cùng
/// `key` bị chặn muộn hơn một bước.
///
/// `value` lưu dạng `String` cho MỌI kiểu, kèm cột `type` mô tả cách đọc. Vì sao không
/// mỗi kiểu một cột: giá phát hành là số 78 chữ số (uint256) nên không vừa `Int`, còn
/// `Decimal(78,0)` thì không lưu được ngưỡng phần trăm hay cờ bật/tắt sau này. Một cột
/// chuỗi + một cột kiểu là cách duy nhất giữ bảng này mở mà không sinh cột rỗng.
///
/// ⚠️ KHÔNG có cột giá trị mặc định. Mặc định nằm ở `lib/config/issue-terms.ts` — mã
/// nguồn, đi cùng bản triển khai. Lưu mặc định ở đây là tạo nguồn thứ hai, và nó lệch
/// ngay lần đổi mã đầu tiên mà không ai chạy lại dữ liệu khởi tạo.
model SystemConfig {
  key       String   @id
  value     String
  /// Cách đọc `value`. Giá trị hợp lệ: CONFIG_VALUE_TYPES ở lib/store/config.store.port.ts
  type      String
  /// Vai đã cập nhật lần cuối — phục vụ đối soát trách nhiệm.
  updatedBy String
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

/// Mọi lần đổi một tham số hệ thống. CHỈ GHI THÊM, không sửa, không xoá.
///
/// Tách khỏi `SystemConfig` vì hai bảng trả lời hai câu hỏi khác nhau: bảng kia trả lời
/// "giá bây giờ là bao nhiêu" (một dòng một khoá), bảng này trả lời "ai đã đổi giá, từ
/// bao nhiêu sang bao nhiêu, vì sao" (nhiều dòng một khoá). Gộp lại thì phải chọn một
/// trong hai và mất câu còn lại.
///
/// `oldValue` để `null` được: lần đặt ĐẦU TIÊN cho một khoá thì không có giá trị cũ, và
/// ghi `"0"` hay `""` vào đó là bịa ra một giá trị chưa từng có hiệu lực.
model SystemConfigHistory {
  id        String   @id @default(uuid())
  key       String
  oldValue  String?
  newValue  String
  /// Vai đã đổi.
  changedBy String
  /// Lý do đổi, hiển thị được trong sổ kiểm toán.
  reason    String?
  changedAt DateTime @default(now()) @db.Timestamptz(3)

  /// Lịch sử của một tham số, mới nhất trước.
  @@index([key, changedAt])
}

/// Dự án điện gió đã token hoá. MỘT dòng cho mỗi token phát hành.
///
/// `totalSupply` ở đây là nguồn DUY NHẤT của con số phát hành. Trước BE-04 không nơi nào
/// trong `app/src` giữ con số này (đã đo: `git grep -nE "20[_.,]?000[_.,]?000" -- app`
/// không ra kết quả), nên `issueInitialSupply` không có gì để đọc. Viết cứng nó vào mã
/// sẽ buộc sửa mã + triển khai lại chỉ để đổi quy mô một đợt phát hành.
///
/// `issuedAt` là cờ "đã phát hành" ở phía cơ sở dữ liệu, `null` = chưa. Nó KHÔNG thay
/// `ILedgerPort.isInitialSupplyMinted()` — chuỗi vẫn là nguồn sự thật cuối cùng — nhưng
/// nó chặn được lần gọi thứ hai TRƯỚC khi tốn một lời gọi mạng, và giữ được mốc thời
/// gian mà chuỗi không cho đọc lại.
model Project {
  id              String    @id @default(uuid())
  /// Mã token, ví dụ "WPT". Duy nhất theo TỪNG CHAIN — xem `@@unique` ở cuối model.
  tokenSymbol     String
  name            String
  /// Tổng cung phát hành một lần. Decimal thay vì BigInt: uint256 vượt tầm int8.
  totalSupply     Decimal   @db.Decimal(78, 0)
  /// Giá trị hợp lệ: PROJECT_STATUSES ở lib/store/project.store.port.ts
  status          String    @default("DRAFT")
  /// ChainKey: hardhat-local | evm | stellar | mock
  chain           String
  /// Địa chỉ hợp đồng token; `null` khi chưa deploy trên chuỗi đang chọn.
  contractAddress String?
  /// Thời điểm phát hành nguồn cung ban đầu; `null` = chưa phát hành.
  issuedAt        DateTime? @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)

  /// DUY NHẤT theo `(tokenSymbol, chain)`, KHÔNG phải `tokenSymbol` một mình.
  ///
  /// Vì sao có `chain` trong khoá: cùng một token tồn tại độc lập trên từng chuỗi, đúng như mọi
  /// bảng khác trong lược đồ này đều mang cột `chain` (Txn, PurchaseOrder, DistributionPeriod,
  /// SettlementRound). Giao diện cho đổi chuỗi, và mỗi chuỗi có trạng thái phát hành riêng: đã
  /// phát hành trên `hardhat-local` không có nghĩa là đã phát hành trên `mock`.
  ///
  /// Duy nhất theo `tokenSymbol` một mình thì toàn hệ chỉ có ĐÚNG MỘT dòng WPT, nằm trên một
  /// chuỗi; mọi chuỗi còn lại tra ra `null` và `issueInitialSupply` từ chối với lý do "chưa có dự
  /// án" — trong khi dự án rõ ràng có. Đó là bản demo chạy được ở một chế độ triển khai và chết ở
  /// chế độ kia, đúng thứ steering đòi tránh khi nói một codebase phục vụ cả free-tier lẫn VPS.
  @@unique([tokenSymbol, chain])
  @@index([chain, status])
}

/// Yêu cầu Mint / Burn theo mô hình lập–duyệt (BE-12): Giao dịch viên lập, Kiểm soát viên duyệt.
///
/// Yêu cầu đang chờ KHÔNG tác động token. Chỉ lần duyệt mới gửi giao dịch, và lần duyệt chiếm
/// quyền bằng một câu `UPDATE ... WHERE "status" = 'PENDING'` để hai người duyệt cùng lúc thì
/// chỉ một lần tác động token.
model TokenRequest {
  id            String    @id @default(uuid())
  /// ChainKey: hardhat-local | evm | stellar | mock
  chain         String
  /// Mã token, khớp `Project.tokenSymbol` trên cùng chuỗi.
  tokenSymbol   String
  /// Giá trị hợp lệ: TOKEN_REQUEST_TYPES ở lib/store/token-request.store.port.ts
  type          String
  /// Số lượng token. Decimal thay vì BigInt: uint256 vượt tầm int8.
  amount        Decimal   @db.Decimal(78, 0)
  /// Chỉ Burn: phần chưa phân phối hoặc toàn bộ nguồn cung. Mint để NULL.
  /// Giá trị hợp lệ: TOKEN_REQUEST_BURN_SOURCES ở lib/store/token-request.store.port.ts
  burnSource    String?
  /// Ví thanh toán của người bán (ví SPV) mà lần duyệt sẽ tác động.
  wallet        String
  reason        String
  /// Số hiệu chứng từ đi kèm.
  documentRef   String?
  effectiveDate DateTime? @db.Timestamptz(3)
  note          String?
  /// Người lập: mã tài khoản + vai tại lúc lập.
  makerId       String
  makerRole     String
  /// Người duyệt hoặc từ chối; NULL khi còn chờ.
  checkerId     String?
  checkerRole   String?
  /// Giá trị hợp lệ: TOKEN_REQUEST_STATUSES ở lib/store/token-request.store.port.ts
  status        String    @default("PENDING")
  rejectReason  String?
  /// Lý do giao dịch thất bại on-chain (trạng thái FAILED).
  failureReason String?
  txHash        String?
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  /// Mốc duyệt hoặc từ chối.
  decidedAt     DateTime? @db.Timestamptz(3)
  /// Mốc có kết cục on-chain (hoàn tất hoặc thất bại).
  completedAt   DateTime? @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)

  /// Một mã giao dịch không gắn cho hai yêu cầu.
  @@unique([txHash])
  @@index([chain, tokenSymbol, status])
  @@index([status, createdAt])
  @@index([makerId, status])
}

model Permission {
  id     String           @id @default(uuid())
  /// vd token:mint
  action String           @unique
  roles  RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}
