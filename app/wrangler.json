{
  "name": "bidv-rwa-tokenize",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "minify": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "bidv-rwa-tokenize"
    }
  ],
  "vars": {
    "USE_MOCK_KYC": "true",
    "USE_MOCK_DB": "true",
    "DEMO_ROLE": "TELLER",
    "ENABLE_DEMO_PAYMENT_MINT": "true",
    "ENABLE_DEMO_TOKEN_MINT": "false"
  }
}
