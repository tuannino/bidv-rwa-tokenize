{
	"name": "bidv-rwa-tokenize",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-07-30",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"keep_vars": true,
	"minify": true,
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "bidv-rwa-tokenize"
		}
	],
	"vars": {
		"USE_MOCK_KYC": "true",
		"USE_MOCK_DB": "false",
		"DEMO_ROLE": "TELLER",
		"ENABLE_DEMO_PAYMENT_MINT": "true",
		"ENABLE_DEMO_TOKEN_MINT": "false",
		"ENABLE_SEPOLIA_DEMO_PROJECT": "true",
		"ENABLE_READ_DIAGNOSTICS": "false",
		"INDEXER_CONFIRMATIONS": "12",
		"INDEXER_SEGMENT_BLOCKS": "50000",
		"INDEXER_MAX_BLOCKS_PER_SYNC": "200000",
		"INDEXER_LEASE_SECONDS": "60"
	},
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "50d67e4a225949cd96413a4c4e167ac2",
			"localConnectionString": "postgresql://bidv:bidv@127.0.0.1:5432/bidv_rwa"
		}
	],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"invocation_logs": true,
			"persist": true
		}
	}
}
