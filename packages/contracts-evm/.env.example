# Biến môi trường để DEPLOY contract lên mạng công khai (Sepolia).
# Copy sang .env rồi điền. .env đã được .gitignore — TUYỆT ĐỐI không commit giá trị thật.
#
#   cp .env.example .env
#
# Chỉ cần cho chain công khai. Với hardhat-local thì KHÔNG cần file này.

# RPC Sepolia. Endpoint công khai không cần key (bị rate-limit, chỉ nên dùng để thử):
#   https://ethereum-sepolia-rpc.publicnode.com
# Deploy + verify nên dùng RPC có API key (Infura/Alchemy) cho ổn định:
#   https://sepolia.infura.io/v3/<API_KEY>
#   https://eth-sepolia.g.alchemy.com/v2/<API_KEY>
# ⚠️ https://rpc.sepolia.org đã CHẾT (trả HTTP 404) — đừng dùng.
SEPOLIA_RPC_URL=

# Khóa ví DEPLOYER = ngân hàng. Ví này nhận toàn bộ role của ProjectToken
# (DEFAULT_ADMIN / MINTER / AGENT / SNAPSHOT / PAUSER) ngay trong constructor.
# Phải có ETH test để trả gas — xin ở faucet, xem docs/TESTNET_SEPOLIA.md.
# Dạng: 0x + 64 ký tự hex.
PRIVATE_KEY=

# API key Etherscan để `npx hardhat verify` (lấy ở https://etherscan.io/myapikey).
# Không có key thì deploy vẫn được, chỉ là không verify được source.
ETHERSCAN_API_KEY=

# Chỉ dùng nếu deploy lên mạng Besu permissioned nội bộ.
BESU_RPC_URL=
BESU_CHAIN_ID=1337
