# Copy sang .env rồi chạy. Mặc định đã đủ để demo MINT ngay (chain hardhat-local + tích hợp mock).
#   cp .env.example .env

# ===== Chain =====
# hardhat-local (mặc định) | evm | stellar | mock   — KHÔNG có Polygon
NEXT_PUBLIC_DEFAULT_CHAIN=hardhat-local
NEXT_PUBLIC_RPC_HARDHAT=http://127.0.0.1:8545

# RPC testnet EVM (Sepolia). Để trống thì dùng endpoint công khai mặc định trong
# packages/shared/src/chains.ts (bị rate-limit — chỉ nên dùng để thử đọc).
# Ghi giao dịch thật nên đặt RPC có API key.
# ⚠️ https://rpc.sepolia.org đã CHẾT (HTTP 404) — đừng dùng.
NEXT_PUBLIC_RPC_EVM=
# Bản KHÔNG public, chỉ server đọc. Nếu đặt thì THẮNG NEXT_PUBLIC_RPC_EVM ở phía server.
# Dùng khi không muốn lộ RPC có API key ra bundle browser.
RPC_EVM=

# ===== Signer ngân hàng (PoC) =====
# ⚠️ Giá trị dưới đây là KHÓA TEST CÔNG KHAI của Hardhat account #0 — ai cũng biết.
#    Dùng ĐƯỢC cho hardhat-local. TUYỆT ĐỐI không dùng cho mạng công khai.
#
# 👉 Khi chạy chain `evm` (Sepolia): THAY bằng khóa ví ngân hàng của bạn — nên trùng ví
#    deployer (ví đó mới có MINTER/AGENT role) và phải có ETH test để trả gas.
#    Xem docs/TESTNET_SEPOLIA.md.
SERVER_SIGNER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
SIGNER_KIND=server

# ===== Địa chỉ contract trên chain `evm` (Sepolia) =====
# Điền SAU khi deploy. Cơ chế: env THẮNG addresses.json (packages/shared/src/addresses.ts),
# nên đây là cách nạp địa chỉ cho free-tier (không đọc được filesystem lúc chạy).
# Bỏ trống nếu đã commit khối "evm" vào packages/shared/src/addresses.json.
NEXT_PUBLIC_ADDR_EVM_PROJECT_TOKEN=
NEXT_PUBLIC_ADDR_EVM_VND_TOKEN=
NEXT_PUBLIC_ADDR_EVM_PROFIT_DISTRIBUTOR=
NEXT_PUBLIC_ADDR_EVM_REDEMPTION=
# Chỉ cần khi bật nhánh oracle của P7 (spec p7-profit-distribution)
NEXT_PUBLIC_ADDR_EVM_ENERGY_ORACLE=
NEXT_PUBLIC_ADDR_EVM_PROFIT_DISTRIBUTOR_ORACLE=

# ===== DB =====
DATABASE_URL=postgresql://bidv:bidv@localhost:5432/bidv_rwa

# ===== Feature flags (mock trước cho nhanh) =====
USE_MOCK_KYC=true
USE_MOCK_ORACLE=true
USE_MOCK_COREBANK=true
# true = lưu Txn/audit trong bộ nhớ (chạy được ở free-tier)
# false = lưu Postgres qua DATABASE_URL (docker compose đặt sẵn false)
USE_MOCK_DB=true

# ===== Vai trò giả lập (PoC) =====
# BANK_ADMIN | COMPLIANCE | INVESTOR | AUDITOR
# ⚠️ KHÔNG phải xác thực. Phase 4 thay bằng SIWE + session.
DEMO_ROLE=BANK_ADMIN

# ===== WalletConnect (tuỳ chọn, cho RainbowKit) =====
NEXT_PUBLIC_WC_PROJECT_ID=

# ===== Deploy target =====
# free-tier: web serverless (Cloudflare), DB Supabase/Neon, chain=mock|evm (KHÔNG hardhat node)
# vps: docker compose (web+db+hardhat node) — demo đầy đủ
DEPLOY_TARGET=free-tier
