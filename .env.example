# Copy sang .env rồi chạy. Mặc định đã đủ để demo MINT ngay bằng ledger mock.
#   cp .env.example .env

# ===== Chain =====
# mock (mặc định) | hardhat-local | evm | stellar   — KHÔNG có Polygon
NEXT_PUBLIC_DEFAULT_CHAIN=mock
NEXT_PUBLIC_RPC_HARDHAT=http://127.0.0.1:8545

# RPC testnet EVM (Sepolia). Để trống thì dùng endpoint công khai mặc định trong
# packages/shared/src/chains.ts (bị rate-limit — chỉ nên dùng để thử đọc).
# Ghi giao dịch thật nên đặt RPC có API key.
# ⚠️ https://rpc.sepolia.org đã CHẾT (HTTP 404) — đừng dùng.
NEXT_PUBLIC_RPC_EVM=
# Bản KHÔNG public, chỉ server đọc. Nếu đặt thì THẮNG NEXT_PUBLIC_RPC_EVM ở phía server.
# Dùng khi không muốn lộ RPC có API key ra bundle browser.
RPC_EVM=

# ===== Signer ngân hàng (PoC) =====
# Nhận cả dạng có và KHÔNG có tiền tố 0x (MetaMask xuất ra dạng không có).
#
# ⚠️ Giá trị dưới đây là KHÓA TEST CÔNG KHAI của Hardhat account #0 — ai cũng biết.
#    Dùng ĐƯỢC cho hardhat-local. TUYỆT ĐỐI không dùng cho mạng công khai.
SERVER_SIGNER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
SIGNER_KIND=server

# Khóa ký RIÊNG theo chain — ưu tiên hơn biến dùng chung ở trên.
# Cần vì ROLE on-chain gắn với TỪNG chain: ví admin của hardhat-local (Hardhat #0) khác ví
# ngân hàng đã deploy lên Sepolia. Chỉ đặt một khóa dùng chung thì đổi chain trên UI sẽ hỏng
# (contract revert AccessControlUnauthorizedAccount).
SERVER_SIGNER_PRIVATE_KEY_HARDHAT_LOCAL=
# Ví ngân hàng trên Sepolia — phải là ví deployer (có MINTER/AGENT role) và có ETH test.
SERVER_SIGNER_PRIVATE_KEY_EVM=

# ===== Địa chỉ contract trên chain `evm` (Sepolia) =====
# Điền SAU khi deploy. Cơ chế: env THẮNG addresses.json (packages/shared/src/addresses.ts),
# nên đây là cách nạp địa chỉ cho free-tier (không đọc được filesystem lúc chạy).
# Bỏ trống nếu đã commit khối "evm" vào packages/shared/src/addresses.json.
NEXT_PUBLIC_ADDR_EVM_PROJECT_TOKEN=
NEXT_PUBLIC_ADDR_EVM_VND_TOKEN=
NEXT_PUBLIC_ADDR_EVM_PROFIT_DISTRIBUTOR=
NEXT_PUBLIC_ADDR_EVM_REDEMPTION=
# Chỉ cần khi bật nhánh oracle của P7 (spec p7-profit-distribution)
NEXT_PUBLIC_ADDR_EVM_ENERGY_ORACLE=
NEXT_PUBLIC_ADDR_EVM_PROFIT_DISTRIBUTOR_ORACLE=

# ===== DB =====
DATABASE_URL=postgresql://bidv:bidv@localhost:5432/bidv_rwa

# ===== Feature flags (mock trước cho nhanh) =====
USE_MOCK_KYC=true
USE_MOCK_ORACLE=true
USE_MOCK_COREBANK=true
# true = lưu Txn/audit trong bộ nhớ (chạy được ở free-tier)
# false = lưu Postgres qua DATABASE_URL (docker compose đặt sẵn false)
USE_MOCK_DB=true

# ===== Chức năng CHỈ DÀNH CHO MÔI TRƯỜNG THỬ =====
# Cho cán bộ ngân hàng tự phát hành VNDB vào ví chỉ định, để có tiền thử luồng mua/chia lợi tức.
#
# ⚠️ Bản PoC mặc định bật để demo trọn luồng. Trước khi triển khai production BẮT BUỘC đặt
#    false: bật ở môi trường thật là cho phép cán bộ TỰ PHÁT HÀNH TIỀN.
#    Đây là lớp chặn thứ hai, độc lập với quyền RBAC `demo:mint-payment`.
ENABLE_DEMO_PAYMENT_MINT=true

# Cho phát hành WPT TRỰC TIẾP, không qua lập–duyệt (màn /mint, POST /api/mint) — để dựng dữ liệu thử.
#
# ⚠️ CẢNH BÁO: chỉ bật trên môi trường THỬ. Từ FE-22, tạo và huỷ token chính thức chỉ đi qua màn
#    Lập lệnh và Kiểm soát viên duyệt; bật cờ này trên môi trường thật là mở lại đường đi vòng qua
#    bước duyệt. Đây là lớp chặn thứ hai, độc lập với quyền RBAC `demo:mint-token`.
ENABLE_DEMO_TOKEN_MINT=false

# ===== Tiến trình định kỳ: tự động chia lợi nhuận (BE-07) =====
# Khoá bí mật của POST /api/keeper/distribution — điểm vào cho cron của hạ tầng.
# Gửi qua header:  Authorization: Bearer <khoá>
#
#   Sinh khoá:  openssl rand -hex 16
#   Gọi thử:    curl -X POST -H "Authorization: Bearer $KEEPER_SECRET" \
#                 -H 'content-type: application/json' -d '{"chain":"mock"}' \
#                 http://localhost:3000/api/keeper/distribution
#   Dọn lệnh treo:  thêm '{"job":"expire-orders"}' vào thân yêu cầu
#
# ⚠️ ĐỂ TRỐNG nghĩa là route TỪ CHỐI MỌI yêu cầu — đó là mặc định đúng, vì lời gọi này
#    chuyển tiền cho nhà đầu tư. Tối thiểu 32 ký tự, cấu hình ngắn hơn sẽ làm app không nạp
#    được (nổ ngay lúc đọc cấu hình, không im lặng chạy với khoá đoán được).
# ⚠️ KHÔNG có biến thể NEXT_PUBLIC_: khoá lọt vào bundle browser là mọi người xem trang đọc được.
KEEPER_SECRET=

# Ba tham số còn lại của tiến trình này nằm trong CƠ SỞ DỮ LIỆU (bảng SystemConfig), không ở
# đây, vì người vận hành phải đổi được mà không cần triển khai lại:
#   distribution.max_batches_per_run  số lô tối đa mỗi lượt      (mặc định 5)
#   distribution.min_new_balance      mức tăng tối thiểu, VNDB   (mặc định 1000)
#   distribution.stuck_after_runs     số vòng thì coi là treo    (mặc định 3)
# Mặc định khai ở app/src/lib/config/issue-terms.ts.

# ===== Vai trò giả lập (PoC) =====
# Bốn vai theo tài liệu yêu cầu người sử dụng (FE-20):
#   INVESTOR   Nhà đầu tư
#   SELLER     Người bán
#   TELLER     Giao dịch viên
#   CONTROLLER Kiểm soát viên
# Thiếu hoặc giá trị lạ quy về TELLER, đồng bộ với khu vực mặc định của bản PoC.
# Cookie vai hợp lệ do người dùng đã chọn vẫn được ưu tiên hơn biến môi trường.
# ⚠️ KHÔNG phải xác thực. Phase 4 thay bằng SIWE + session.
DEMO_ROLE=TELLER
# Mã tài khoản giả lập (BE-12) — ghi vào cột người lập / người duyệt của yêu cầu Mint/Burn.
# Để trống thì lấy mã mẫu của vai (GDV001, KSV001, ...). Người lập không duyệt được yêu cầu
# của chính mình: phép so theo mã này, không theo vai. AU-01 thay bằng phiên đăng nhập.
DEMO_ACTOR=

# ===== WalletConnect (tuỳ chọn, cho RainbowKit) =====
NEXT_PUBLIC_WC_PROJECT_ID=

# ===== Deploy target =====
# free-tier: web serverless (Cloudflare), DB Supabase/Neon, chain=mock|evm (KHÔNG hardhat node)
# vps: docker compose (web+db+hardhat node) — demo đầy đủ
DEPLOY_TARGET=free-tier
